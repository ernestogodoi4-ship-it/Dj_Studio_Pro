{
  "name": "melody-studio",
  "version": "1.0.0",
  "description": "Melody Studio — estação independente de composição musical",
  "main": "main.js",
  "author": "Synk Audio Factory",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.synkaudio.melodystudio",
    "productName": "Melody Studio",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "app/**/*"
    ],
    "win": {
      "icon": "app/melody-studio.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Melody Studio",
      "uninstallDisplayName": "Melody Studio"
    },
    "artifactName": "Melody_Studio_Setup_${version}.${ext}"
  }
}
